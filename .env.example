# DIODESHIELD Configuration Environment Variables
# Passive OT Threat Detection for Data Diode Protected Networks

# Database storage path
DIODESHIELD_DB=data/diodeshield.db

# Configuration file
DIODESHIELD_CONFIG=configs/default.yaml

# Firewall safety control (strictly disabled by default; Windows Netsh only)
DIODESHIELD_FIREWALL_BLOCKING=false

# Capture interface ('auto', interface name, or GUID)
DIODESHIELD_INTERFACE=auto

# Packet capture binary locations
DIODESHIELD_TSHARK=tshark
DIODESHIELD_ZEEK=zeek

# Optional security API key (leave empty to disable authentication)
DIODESHIELD_API_KEY=

# CORS allowed origins (comma-separated)
DIODESHIELD_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Server host and port
DIODESHIELD_HOST=0.0.0.0
DIODESHIELD_PORT=8000
